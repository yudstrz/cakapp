# Neon PostgreSQL
DATABASE_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth & Google OAuth
BETTER_AUTH_SECRET="your-better-auth-secret"
BETTER_AUTH_URL="https://cakapp.vercel.app"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Shared Server-Only AI Keys (Vercel Environment Variables, NEVER prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Upstash Redis (Rate Limiting, Model Cache, & Global Budget)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# AI Cost & Access Controls
AI_DAILY_BUDGET_USD="5"
AI_KILL_SWITCH="false"
AI_ALLOW_PREMIUM="false"
